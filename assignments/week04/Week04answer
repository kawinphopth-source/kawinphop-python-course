# รับชื่อจริง(หรือข้อความ)จากผู้ใช้
# นับจำนวนสระทั้งหมดในข้อความว่ามีกี่ตัว (a,e,i,o,u)

# ตัวอย่างหน้าจอ
# What is your name?: Boonchoo
# Your text have 4 vowels.

# 1st method
name = input("What is your name?: ")
letters = list(name)
a = letters.count('a')
e = letters.count('e')
i = letters.count('i')
o = letters.count('o')
u = letters.count('u')
A = letters.count('A')
E = letters.count('E')
I = letters.count('I')
O = letters.count('O')
U = letters.count('U')
vowels = a+e+i+o+u+A+E+I+O+U
print(f"Your text have {vowels} vowels")

